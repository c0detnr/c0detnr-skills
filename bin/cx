#!/usr/bin/env bash
# cx — Opus'un işleri Codex modellerine devretmesi için ince sarmalayıcı.
# Ham loglar diske yazılır; ekrana (Opus'a) yalnızca kısa bir özet basılır.
set -uo pipefail

KIT_DIR="${CX_KIT_DIR:-$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)}"
SCHEMA="$KIT_DIR/share/sonuc.schema.json"

# --- platform: Windows'ta (Git Bash/MSYS) yerel exe'lere (codex, agy) giden yollar C:\... biçiminde olmalı
case "$(uname -s)" in MINGW*|MSYS*|CYGWIN*) IS_WIN=1 ;; *) IS_WIN=0 ;; esac
winpath() { if [ "$IS_WIN" = 1 ]; then cygpath -w "$1"; else printf '%s' "$1"; fi; }
# python3 Windows'ta çoğu zaman Microsoft Store taslağıdır; gerçekten çalışan ilk yorumlayıcıyı seç
PY="${CX_PYTHON:-}"
if [ -z "$PY" ]; then
  for c in python3 python py; do
    "$c" -c 'import sys;sys.exit(sys.version_info<(3,6))' >/dev/null 2>&1 && { PY="$c"; break; }
  done
fi
[ -n "$PY" ] || { echo "cx: Python 3 bulunamadı (CX_PYTHON ile belirtin)" >&2; exit 2; }
export PYTHONUTF8=1 PYTHONIOENCODING=utf-8   # Windows'ta cp1254 yerine UTF-8
# --- ~/.c0detnr: ayarlar, loglar, token kaydı
CX_HOME="${CX_HOME:-$HOME/.c0detnr}"
STATE="$CX_HOME"
USAGE="$STATE/usage.csv"

# --- ayarlar: varsayılan < ~/.c0detnr/config < <proje>/.c0detnr/config < ortam değişkenleri
declare -A CFG=(
  [kod]="gpt-6.1-sol medium"   [test]="gpt-6.1-sol medium"  [hata]="gpt-6.1-sol high"
  [zor]="gpt-6-astra high"     [basit]="gpt-6-luna low"     [devam]="gpt-6.1-sol medium"
  [resim]="gpt-6.1-sol low"    [incele]="gpt-6.1-sol medium"
  [commit]="gpt-6-luna low"    [pr]="gpt-6-luna low"
  [ozet]="gemini-3.8-flash-low"   [tara]="gemini-3.8-flash-medium"
  [gor]="gemini-3.8-flash-medium" [ikinci]="claude-sonnet-4-6"
  [yedek]="gemini-3.8-flash-high" [ozet_yedek]="gpt-6-luna low" [yedek_acik]="1"
  [timeout]="1800" [max_out]="1500"
)
CFG_FILES=()
load_cfg() {  # anahtar = değer satırları; kod çalıştırmaz (source edilmez)
  local f="$1" k v line
  [ -f "$f" ] || return 0
  CFG_FILES+=("$f")
  while IFS= read -r line || [ -n "$line" ]; do
    line="${line%$'\r'}"; line="${line%%#*}"
    [[ "$line" == *=* ]] || continue
    k="${line%%=*}"; v="${line#*=}"
    k="${k//[[:space:]]/}"; read -r v <<< "$v"
    [ -n "$k" ] && [ -n "$v" ] && CFG[$k]="$v"
  done < "$f"
}
load_cfg "$CX_HOME/config"
PROJ_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
[ "$PROJ_ROOT/.c0detnr" != "$CX_HOME" ] && load_cfg "$PROJ_ROOT/.c0detnr/config"
# cfgm <mod> -> MDL ve EFF değişkenlerini doldurur ("model [effort]")
cfgm() { read -r MDL EFF _ <<< "${CFG[$1]:-}"; EFF="${EFF:-medium}"; }

MAX_OUT="${CX_MAX_OUT:-${CFG[max_out]}}"   # Opus'a dönen en fazla karakter
TIMEOUT="${CX_TIMEOUT:-${CFG[timeout]}}"
YEDEK_ACIK="${CX_YEDEK:-${CFG[yedek_acik]}}"

usage() {
  echo 'kullanım: cx <mod> ["talimat"]   (talimat argüman ya da stdin)'
  local m d
  while IFS='|' read -r m d; do
    printf '  %-7s %-44s %s\n' "$m" "$d" "${CFG[$m]:-}"
  done <<'E'
kod|yeni özellik / refactor
test|test yaz, geçene kadar düzelt
hata|hata ayıkla ve düzelt
zor|zor sorun / ikinci görüş
basit|lint, rename, docs, çeviri
ozet|stdin'deki logu özetle (npm test 2>&1 | cx ozet)
tara|"soru" kod tabanını okuyup cevapla (salt okuma)
gor|<resim> ["soru"] görsel analizi (salt okuma)
ikinci|değişikliklere ikinci inceleme (salt okuma)
resim|"prompt" <hedef.png>
incele|commit edilmemiş değişiklikleri incele
commit|staged diff'ten mesaj yaz ve commit at
pr|[base] PR açıklaması yaz
devam|<id> "ek talimat" önceki oturumu sürdür
E
  printf '  %-7s %s\n' durum "token kullanım özeti" config "etkin ayarları ve dosya yollarını göster"
  echo "Modelleri değiştirmek için: $CX_HOME/config (cx config). Tek seferlik: CX_MODEL, CX_EFFORT, CX_AGY_MODEL."
}

die() { echo "cx: $*" >&2; exit 2; }
clip() { "$PY" -I -X utf8 -c 'import sys;s=sys.stdin.read();n=int(sys.argv[1]);print(s if len(s)<=n else s[:n]+"\n…(kırpıldı)")' "$1"; }
in_git() { git rev-parse --is-inside-work-tree >/dev/null 2>&1; }

MODE="${1:-}"; [ -z "$MODE" ] && { usage; exit 2; }; shift || true

RUN="$STATE/runs/$(date +%Y%m%d-%H%M%S)-$MODE-$$"
mkdir -p "$RUN"; trap 'rmdir "$RUN" 2>/dev/null' EXIT   # boş kalırsa sil
[ -f "$USAGE" ] || echo "zaman,mod,model,effort,girdi,onbellek,cikti,sure_sn,rc,dizin" > "$USAGE"

PRE_ORTAK='Sen bir alt ajansın; seni başka bir ajan yönetiyor. Görevi sonuna kadar kendin bitir. Soru sormak yerine makul varsayım yap ve varsayımları "sorular" alanına yaz. Git commit/push yapma. Bitince yalnızca şemaya uygun JSON dön; "ozet" en fazla 5 kısa satır olsun.'

# --- codex çağrısı: run_codex <model> <effort> <sandbox> <ephemeral:0/1> [ek argümanlar...] ; prompt $RUN/prompt.md
run_codex() {
  local model="${CX_MODEL:-$1}" effort="${CX_EFFORT:-$2}" sandbox="$3" eph="$4"; shift 4
  local args=(exec -m "$model" -c "model_reasoning_effort=\"$effort\"" -s "$sandbox"
              --skip-git-repo-check --json -o "$RUN/last.txt")
  [ "$sandbox" = workspace-write ] && args+=(-c 'sandbox_workspace_write.network_access=true')
  [ "$eph" = 1 ] && args+=(--ephemeral)
  args+=("$@" -)
  local t0=$SECONDS
  timeout "$TIMEOUT" codex "${args[@]}" < "$RUN/prompt.md" > "$RUN/events.jsonl" 2> "$RUN/stderr.txt"
  RC=$?; DUR=$((SECONDS - t0)); MODEL_USED="$model"; EFFORT_USED="$effort"
  log_usage
}

log_usage() {
  "$PY" -I -X utf8 - "$RUN/events.jsonl" "$USAGE" "$MODE" "$MODEL_USED" "$EFFORT_USED" "$DUR" "$RC" "$RUN" <<'P'
import json,sys,time
ev,out,mode,model,eff,dur,rc,run=sys.argv[1:]
i=c=o=0; tid=""
try:
    for line in open(ev,encoding="utf-8",errors="replace"):
        try: e=json.loads(line)
        except Exception: continue
        if e.get("type")=="thread.started": tid=e.get("thread_id","")
        u=e.get("usage") if isinstance(e.get("usage"),dict) else None
        if u:
            i+=u.get("input_tokens",0); c+=u.get("cached_input_tokens",0); o+=u.get("output_tokens",0)
except FileNotFoundError: pass
open(out,"a",encoding="utf-8").write(f"{time.strftime('%F %T')},{mode},{model},{eff},{i},{c},{o},{dur},{rc},{run}\n")
open(run+"/thread_id","w",encoding="utf-8").write(tid)
P
  THREAD="$(cat "$RUN/thread_id" 2>/dev/null)"
}

# --- agy (Antigravity) çağrısı: run_agy <model> <plan|auto> ; prompt $RUN/prompt.md
# plan = salt okuma (dosya yazamaz), auto = yazabilir. Sonuç metni $RUN/last.txt'ye yazılır.
run_agy() {
  local model="${CX_AGY_MODEL:-$1}" mode="$2" t0=$SECONDS
  echo "Ara adımları, düşüncelerini ve ne yapacağını anlatma; yalnızca istenen son cevabı yaz." >> "$RUN/prompt.md"
  timeout "$TIMEOUT" agy -p "$(cat "$RUN/prompt.md")" --model "$model" --mode "$mode" --sandbox \
    --dangerously-skip-permissions --output-format json --print-timeout "${TIMEOUT}s" \
    > "$RUN/agy.json" 2> "$RUN/stderr.txt"
  RC=$?; DUR=$((SECONDS - t0)); MODEL_USED="$model"; EFFORT_USED="$mode"
  "$PY" -I -X utf8 - "$RUN" "$USAGE" "$MODE" "$model" "$mode" "$DUR" "$RC" "$(winpath "$PWD")" <<'P'
import json,re,sys,time
run,out,mode,model,eff,dur,rc,cwd=sys.argv[1:]
try: d=json.load(open(run+"/agy.json",encoding="utf-8",errors="replace"))
except Exception: d={}
u=d.get("usage") or {}
if isinstance(u,str):
    try: u=json.loads(u.replace("'",'"'))
    except Exception: u={}
r=d.get("response") or ""
r=re.sub(r"\[([^\]]*)\]\(file://[^)]*\)",r"\1",r)
# Windows: C:\x\y\ ve C:/x/y/ biçimlerinin ikisini de sadeleştir
for p in {cwd, cwd.replace("\\","/")}: r=r.replace(p.rstrip("/\\")+"/","").replace(p.rstrip("/\\")+"\\","")  # file:// linklerini sadeleştir
open(run+"/last.txt","w",encoding="utf-8").write(r)
open(run+"/thread_id","w",encoding="utf-8").write(d.get("conversation_id",""))
if rc=="0" and (d.get("status")!="SUCCESS" or not r.strip()): open(run+"/agy_fail","w",encoding="utf-8").write(d.get("status","?"))
open(out,"a",encoding="utf-8").write(f"{time.strftime('%F %T')},{mode},{model},{eff},{u.get('input_tokens',0)},{u.get('cache_read_tokens',0)},{u.get('output_tokens',0)},{dur},{rc},{run}\n")
P
  [ -f "$RUN/agy_fail" ] && RC=1
  THREAD="$(cat "$RUN/thread_id" 2>/dev/null)"
}

# Codex başarısız olursa (kota, hata) Gemini ile bir kez daha dene. Kapatmak için config: yedek_acik = 0 (ya da CX_YEDEK=0)
yedek_dene() {
  [ "$RC" -eq 0 ] || [ "$YEDEK_ACIK" = 0 ] || ! command -v agy >/dev/null && return
  echo "(codex başarısız rc=$RC; gemini yedeği deneniyor)"
  printf '\nSon mesajın yalnızca şu biçimde JSON olsun: {"durum":"tamam|kismen|basarisiz","ozet":"≤5 satır","degisen_dosyalar":[],"testler":"","sorular":[]}\n' >> "$RUN/prompt.md"
  run_agy "${CFG[yedek]}" auto
}

fail_report() {
  echo "[cx $MODE] HATA rc=$RC (${DUR}s) log: $RUN"
  tail -n 5 "$RUN/stderr.txt" | clip 600
  exit 1
}

# Şemalı sonucu kısa metne çevirir.
report() {
  [ "$RC" -ne 0 ] && fail_report
  {
    echo "[cx $MODE] $MODEL_USED/$EFFORT_USED ${DUR}s id=${THREAD:-?} log=$RUN"
    "$PY" -I -X utf8 - "$RUN/last.txt" <<'P'
import json,sys
raw=open(sys.argv[1],encoding="utf-8",errors="replace").read().strip()
j=raw[raw.find("{"):raw.rfind("}")+1] if "{" in raw else raw   # ```json çitlerini atla
try: d=json.loads(j)
except Exception: print(raw); sys.exit()
if d.get("durum"): print(f"durum: {d['durum']}")
print(d.get("ozet",""))
if d.get("degisen_dosyalar"): print("dosyalar: "+", ".join(d["degisen_dosyalar"]))
if d.get("testler"): print("testler: "+d["testler"])
if d.get("sorular"): print("sorular: "+" | ".join(d["sorular"]))
P
    in_git && git diff --stat HEAD 2>/dev/null | tail -n 1
  } | clip "$MAX_OUT"
}

read_task() {  # talimatı argümandan ya da stdin'den al
  if [ $# -gt 0 ]; then printf '%s\n' "$*"; elif [ ! -t 0 ]; then cat; else die "talimat yok"; fi
}

case "$MODE" in
  kod|test|hata|zor|basit)
    task="$(read_task "$@")"
    case "$MODE" in
      kod)   cfgm "$MODE"; m=$MDL e=$EFF eph=0 extra="" ;;
      test)  cfgm "$MODE"; m=$MDL e=$EFF eph=0 extra="Testleri yaz, çalıştır; hepsi geçene kadar düzelt. Var olan testleri silme/gevşetme." ;;
      hata)  cfgm "$MODE"; m=$MDL e=$EFF eph=0 extra="Önce hatayı yeniden üret, kök nedeni bul, en küçük doğru düzeltmeyi yap, sonra doğrula. Kök nedeni özette belirt." ;;
      zor)   cfgm "$MODE"; m=$MDL e=$EFF eph=0 extra="Bu, diğer modellerin zorlandığı bir iş. Derinlemesine düşün." ;;
      basit) cfgm "$MODE"; m=$MDL e=$EFF eph=1 extra="Mekanik bir iş; kapsam dışına çıkma." ;;
    esac
    printf '%s\n%s\n\nGÖREV:\n%s\n' "$PRE_ORTAK" "$extra" "$task" > "$RUN/prompt.md"
    run_codex "$m" "$e" workspace-write "$eph" --output-schema "$SCHEMA"
    yedek_dene
    report ;;

  devam)
    id="${1:-}"; [ -z "$id" ] && die "kullanım: cx devam <id> \"talimat\""; shift
    read_task "$@" > "$RUN/prompt.md"
    # Önceki oturumun modelini kullanmak için CX_MODEL verilmezse sol/medium varsayılır.
    cfgm devam; run_codex "$MDL" "$EFF" workspace-write 0 resume "$id"
    THREAD="$id"; report ;;

  ozet)  # tüm log Gemini'ye (dosyadan okur); olmazsa son 60 KB luna'ya
    [ -t 0 ] && die "kullanım: <komut> 2>&1 | cx ozet [\"odak\"]"
    tail -c 8000000 > "$RUN/girdi.log"
    talimat="En fazla 6 satırda özetle. Hataları dosya:satır ile ver, tekrarları birleştir, başarılı satırları atla.${1:+ Odak: $*}"
    if command -v agy >/dev/null; then
      printf '%s dosyasını oku. Başka araç kullanma. %s\n' "$(winpath "$RUN/girdi.log")" "$talimat" > "$RUN/prompt.md"
      run_agy "${CFG[ozet]}" plan
    else RC=1; fi
    if [ "$RC" -ne 0 ]; then
      { echo "$talimat Araç kullanma."; echo; echo "ÇIKTI (son kısım):"; tail -c 60000 "$RUN/girdi.log"; } > "$RUN/prompt.md"
      cfgm ozet_yedek; run_codex "$MDL" "$EFF" read-only 1
    fi
    [ "$RC" -ne 0 ] && fail_report
    clip "$MAX_OUT" < "$RUN/last.txt" ;;

  tara)  # kod tabanı sorusu; salt okuma
    soru="$(read_task "$@")"
    printf 'Bu depoda (%s) şu soruyu cevapla: %s\n\nKodu oku ama hiçbir dosyayı değiştirme. Cevap en fazla 15 satır; önemli yerleri göreli dosya:satır olarak ver. Plan/artifact oluşturma, onay isteme.\n' "$(winpath "$PWD")" "$soru" > "$RUN/prompt.md"
    run_agy "${CX_TARA_MODEL:-${CFG[tara]}}" plan
    [ "$RC" -ne 0 ] && fail_report
    { echo "[cx tara] $MODEL_USED ${DUR}s"; cat "$RUN/last.txt"; } | clip "${CX_MAX_OUT:-2500}" ;;

  gor)  # resim/ekran görüntüsü analizi; Opus resmi hiç yüklemez
    [ $# -lt 1 ] && die "kullanım: cx gor <resim> [\"soru\"]"
    resim="$(realpath "$1")"; [ -f "$resim" ] || die "dosya yok: $1"; shift
    printf 'Şu görseli incele: %s\nSoru: %s\nYalnızca görseli oku, başka dosyaya dokunma. En fazla 8 satır cevap ver. Plan/artifact oluşturma.\n' \
      "$(winpath "$resim")" "${*:-Görselde ne var? Arayüzse hataları/bozuklukları listele.}" > "$RUN/prompt.md"
    run_agy "${CFG[gor]}" plan
    [ "$RC" -ne 0 ] && fail_report
    { echo "[cx gor] ${DUR}s"; cat "$RUN/last.txt"; } | clip "$MAX_OUT" ;;

  ikinci)  # farklı model ailesiyle (Claude Sonnet 4.6) ikinci inceleme
    in_git || die "git deposu değil"
    printf 'Bu depodaki commit edilmemiş değişiklikleri incele (git diff HEAD ve git status ile izlenmeyen yeni dosyalar).%s\nYalnızca gerçek hataları, güvenlik sorunlarını ve kırılan davranışları raporla; stil yorumu yapma. Her bulgu: dosya:satır, sorun, neden. Bulgu yoksa "Bulgu yok." yaz. Hiçbir dosyayı değiştirme, plan/artifact oluşturma.\n' "${1:+ Odak: $*}" > "$RUN/prompt.md"
    run_agy "${CFG[ikinci]}" plan
    [ "$RC" -ne 0 ] && fail_report
    { echo "[cx ikinci] $MODEL_USED ${DUR}s"; cat "$RUN/last.txt"; } | clip "${CX_MAX_OUT:-2500}" ;;

  resim)
    [ $# -lt 2 ] && die "kullanım: cx resim \"prompt\" <hedef.png>"
    prompt="$1"; hedef="$(realpath -m "$2")"; mkdir -p "$(dirname "$hedef")"
    touch "$RUN/.basla"
    printf 'Görsel üretme aracınla şu görseli üret: %s\n\nÜretilen dosyayı şu yola kopyala: %s\nBaşka hiçbir şey yapma. Son mesajın yalnızca dosya yolu olsun.\n' "$prompt" "$(winpath "$hedef")" > "$RUN/prompt.md"
    cfgm resim; run_codex "$MDL" "$EFF" workspace-write 1 --enable image_generation
    CODEX_DIR="${CODEX_HOME:-$HOME/.codex}"; [ "$IS_WIN" = 1 ] && CODEX_DIR="$(cygpath -u "$CODEX_DIR")"
    if [ ! -s "$hedef" ]; then  # model kopyalamadıysa en yeni üretilen görseli al
      yeni="$(find "$CODEX_DIR/generated_images" -type f -newer "$RUN/.basla" -printf '%T@ %p\n' 2>/dev/null | sort -n | tail -1 | cut -d' ' -f2-)"
      [ -n "$yeni" ] && cp "$yeni" "$hedef"
    fi
    if [ -s "$hedef" ]; then echo "[cx resim] ${DUR}s -> $hedef ($(du -h "$hedef" | cut -f1))"
    else RC=${RC:-1}; [ "$RC" -eq 0 ] && RC=1; fail_report; fi ;;

  incele)
    in_git || die "git deposu değil"
    cfgm incele; m="${CX_MODEL:-$MDL}"; e="${CX_EFFORT:-$EFF}"; t0=$SECONDS
    timeout "$TIMEOUT" codex exec review --uncommitted -m "$m" -c "model_reasoning_effort=\"$e\"" "$@" \
      > "$RUN/last.txt" 2> "$RUN/stderr.txt"
    RC=$?; DUR=$((SECONDS - t0)); MODEL_USED=$m; EFFORT_USED=$e; : > "$RUN/events.jsonl"; log_usage
    [ "$RC" -ne 0 ] && fail_report
    { echo "[cx incele] $m/$e ${DUR}s log=$RUN"; cat "$RUN/last.txt"; } | clip "${CX_MAX_OUT:-2500}" ;;

  commit)
    in_git || die "git deposu değil"
    if git diff --cached --quiet; then git add -A; echo "(staged değişiklik yoktu; tümü eklendi)"; fi
    git diff --cached --quiet && die "commit edilecek değişiklik yok"
    { echo "Aşağıdaki staged diff için Conventional Commits biçiminde commit mesajı yaz. İlk satır ≤72 karakter; gerekirse boş satırdan sonra en fazla 4 madde. Diff'in dilini/proje dilini kullan. Yalnızca mesajı yaz; kod bloğu, tırnak ya da açıklama ekleme. Araç kullanma."
      [ $# -gt 0 ] && echo "Bağlam: $*"
      echo; git diff --cached --stat; echo; git diff --cached | head -c 15000; } > "$RUN/prompt.md"
    cfgm commit; run_codex "$MDL" "$EFF" read-only 1
    [ "$RC" -ne 0 ] && fail_report
    sed -i '/^```/d' "$RUN/last.txt"
    [ -s "$RUN/last.txt" ] || die "boş commit mesajı"
    git commit -q -F "$RUN/last.txt" && git log -1 --format='[cx commit] %h %s' ;;

  pr)
    in_git || die "git deposu değil"
    base="${1:-$(git symbolic-ref -q --short refs/remotes/origin/HEAD 2>/dev/null || echo main)}"
    { echo "Bu dal için PR açıklaması yaz (Markdown): ## Özet (2-4 madde), ## Değişiklikler, ## Test. Kısa tut. Araç kullanma."
      echo; git log --oneline "$base"..HEAD | head -50; echo; git diff --stat "$base"...HEAD | tail -40
      echo; git diff "$base"...HEAD | head -c 20000; } > "$RUN/prompt.md"
    cfgm pr; run_codex "$MDL" "$EFF" read-only 1
    [ "$RC" -ne 0 ] && fail_report
    cp "$RUN/last.txt" "$RUN/PR.md"; echo "[cx pr] ${DUR}s açıklama: $RUN/PR.md" ;;

  config)  # etkin ayarlar; ~/.c0detnr/config yoksa örnekten oluştur
    if [ ! -f "$CX_HOME/config" ]; then
      mkdir -p "$CX_HOME"; cp "$KIT_DIR/share/config.ornek" "$CX_HOME/config"
      echo "(oluşturuldu: $(winpath "$CX_HOME/config"))"; load_cfg "$CX_HOME/config"
    fi
    echo "ayar dosyaları (sonraki öncekini ezer):"
    echo "  $(winpath "$CX_HOME/config")"
    echo "  $(winpath "$PROJ_ROOT/.c0detnr/config") $([ -f "$PROJ_ROOT/.c0detnr/config" ] || echo '(yok)')"
    echo "etkin değerler:"
    for k in kod test hata zor basit devam resim incele commit pr ozet tara gor ikinci yedek ozet_yedek yedek_acik timeout max_out; do
      printf '  %-11s %s
' "$k" "${CFG[$k]}"
    done
    echo "loglar: $(winpath "$STATE/runs")" ;;

  durum)
    [ -f "$USAGE" ] || { echo "kayıt yok"; exit 0; }
    "$PY" -I -X utf8 - "$USAGE" <<'P'
import csv,sys,collections
t=collections.defaultdict(lambda:[0,0,0,0,0])
for r in csv.DictReader(open(sys.argv[1],encoding="utf-8",newline="")):
    k=(r["mod"],r["model"]); a=t[k]
    a[0]+=1; a[1]+=int(r["girdi"] or 0); a[2]+=int(r["onbellek"] or 0); a[3]+=int(r["cikti"] or 0); a[4]+=int(r["sure_sn"] or 0)
print(f"{'mod':8}{'model':26}{'çağrı':>6}{'girdi':>10}{'önbellek':>10}{'çıktı':>9}{'sn':>7}")
for (m,mo),a in sorted(t.items()): print(f"{m:8}{mo:26}{a[0]:>6}{a[1]:>10}{a[2]:>10}{a[3]:>9}{a[4]:>7}")
P
    ;;
  -h|--help|yardim) usage ;;
  *) usage; exit 2 ;;
esac
